<%- | 
  String $path,
  String $group,
  Array[String] $extra_read_groups,
  Array[String] $writers,
  Boolean $allow_writers
| -%>
user::rwx
<% if $allow_writers { -%>
<% $writers.each |$u| { -%>
user:<%= $u %>:rwx
<% } -%>
<% } -%>
group::r-x
group:<%= $group %>:r-x
<% $extra_read_groups.each |$g| { -%>
group:<%= $g %>:r-x
<% } -%>
mask::<%= $allow_writers ? { true => 'rwx', false => 'r-x' } %>
other::---

default:user::rwx
<% if $allow_writers { -%>
<% $writers.each |$u| { -%>
default:user:<%= $u %>:rwx
<% } -%>
<% } -%>
default:group::r-x
default:group:<%= $group %>:r-x
<% $extra_read_groups.each |$g| { -%>
default:group:<%= $g %>:r-x
<% } -%>
default:mask::<%= $allow_writers ? { true => 'rwx', false => 'r-x' } %>
default:other::---
