<%- | Array[Hash] $accounting_map, String[1] $default_group | -%>
# Managed by Puppet (profile::htcondor::ce_settings).
# AssignAccountingGroup map for the schedd: first match wins, the last line is the
# fallback (jobs from token-only submissions have no proxy VO). Add VOs in Hiera
# (profile::htcondor::ce_settings::accounting_map).
<% $accounting_map.each |$entry| { -%>
* <%= $entry['pattern'] %> <%= $entry['group'] %>
<% } -%>
* /.*/ <%= $default_group %>
