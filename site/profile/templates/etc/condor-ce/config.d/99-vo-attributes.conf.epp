<%- | Array[Hash] $owner_vos | -%>
# Managed by Puppet (profile::htcondor::ce_settings).
#
# Put the VO attributes on the routed job. The CE job has VoName and
# x509UserProxyVOName, but they are not carried to the routed job, so Auditor
# (and anything reading the schedd history) cannot see the VO. The pre-route
# transform OrigRequests (42-job-router.conf) saves them as orig_*; the
# post-route transforms below restore them.
#
# Jobs without a VoName after that (token-only jobs) get one from the local
# pool account name, which is stable (token issuers are not). The patterns are
# the ones of the schedd accounting map plus
# profile::htcondor::ce_settings::owner_vos; the first match wins. Jobs whose
# owner matches nothing get no VoName.
JOB_ROUTER_POST_ROUTE_TRANSFORM_NAMES = $(JOB_ROUTER_POST_ROUTE_TRANSFORM_NAMES) RestoreVoName RestoreProxyVOName<% $owner_vos.each |$i, $e| { %> OwnerVoName<%= $i %><% } %>

JOB_ROUTER_TRANSFORM_RestoreVoName @=end
    REQUIREMENTS orig_VoName =!= undefined
    COPY orig_VoName VoName
@end

JOB_ROUTER_TRANSFORM_RestoreProxyVOName @=end
    REQUIREMENTS orig_x509UserProxyVOName =!= undefined
    COPY orig_x509UserProxyVOName x509UserProxyVOName
@end
<% $owner_vos.each |$i, $e| { -%>

JOB_ROUTER_TRANSFORM_OwnerVoName<%= $i %> @=end
    REQUIREMENTS VoName =?= undefined && <%= $e['match'] %>
    SET VoName "<%= $e['vo'] %>"
@end
<% } -%>
