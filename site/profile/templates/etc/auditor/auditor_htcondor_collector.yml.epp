<%- | String[1] $api_addr,
      Integer[1, 65535] $api_port,
      Stdlib::Absolutepath $state_db,
      Integer[1] $interval,
      String[1] $pool,
      Array[String[1], 1] $schedd_names,
      Array[Integer, 1] $job_status,
      String[1] $record_prefix,
      String[1] $site_name,
      String[1] $benchmark,
      Optional[String[1]] $earliest_datetime | -%>
# Managed by Puppet (profile::auditor::htcondor_collector)
addr: <%= $api_addr %>
port: <%= $api_port %>
timeout: 10
state_db: <%= $state_db %>
record_prefix: <%= $record_prefix %>
interval: <%= $interval %>
<% if $earliest_datetime { -%>
# only used on the first start (empty state database); quoted so YAML keeps a string
earliest_datetime: "<%= $earliest_datetime %>"
<% } -%>
query_type: exec
pool: <%= $pool %>
schedd_names:
<% $schedd_names.each |$s| { -%>
  - <%= $s %>
<% } -%>
job_status:
<% $job_status.each |$j| { -%>
  - <%= $j %>
<% } -%>

meta:
  user:
    key: Owner
    matches: ^(.+)$
  group:
    key: VoName
    matches: ^(.+)$
  submithost:
    key: GlobalJobId
    matches: ^(.*)#\d+.\d+#\d+$
  site:
    - name: "<%= $site_name %>"
      key: LastRemoteHost
      matches: ^slot.+@.+$

components:
  - name: Cores
    key: CpusProvisioned
    scores:
      - name: "<%= $benchmark %>"
        key: MachineAttrApelSpecs0
        matches: (?:<%= $benchmark %>|HEPSCORE)\D+(\d+(\.\d+)?)
  - name: Memory
    key: MemoryProvisioned
  - name: TotalCPU
    key: "CumulativeRemoteUserCpu+CumulativeRemoteSysCpu"

tls_config:
  use_tls: False
